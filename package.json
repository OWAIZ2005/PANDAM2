{
  "name": "pandam",
  "version": "0.1.0",
  "private": true,
  "description": "PANDAM - direct barter marketplace (technical foundation)",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "^20.19.4 || ^22.13.0 || >=24.3.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:app": "turbo run dev --filter=@pandam/app",
    "dev:worker": "turbo run dev --filter=@pandam/worker",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,mjs,cjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,mjs,cjs}\"",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@expo/ngrok": "4",
    "@pandam/config": "workspace:*",
    "eslint": "^8.57.1",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "react-native-reanimated": "4.5.1",
      "react-native-worklets": "0.10.1"
    }
  }
}
