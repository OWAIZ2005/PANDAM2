# =============================================================================
# PANDAM environment variables (EXAMPLE)
# Copy to .env / .env.local and fill in. NEVER commit real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# Expo app (apps/app)
# Public values only. Anything prefixed EXPO_PUBLIC_ is embedded in the client
# bundle and is NOT secret.
# -----------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:8787
EXPO_PUBLIC_WS_URL=ws://localhost:8787
EXPO_PUBLIC_ENV=development

# Client-only demo showcase overlay (fake `demo-...` ids on top of whatever
# the API actually returns). Leave at 0/unset for real data — e.g. after
# running `node scripts/seed-showcase.mjs`, which creates the same showcase
# as REAL rows instead. See README "Demo data".
EXPO_PUBLIC_DEMO_DATA=0

# Sentry (client)
EXPO_PUBLIC_SENTRY_DSN=

# PostHog (client)
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google sign-in (optional). Not secret — embedded in the client bundle.
# From your own Google Cloud Console OAuth clients (console.cloud.google.com
# → APIs & Services → Credentials → Create Credentials → OAuth client ID).
# See README "Social sign-in".
#
# WEB: an "Web application" OAuth client. Used by the web redirect flow AND
# as `webClientId` for the native iOS/Android SDK (that's what makes Google
# sign the returned token's `aud` for a client PANDAM's server can verify).
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=
# IOS: an "iOS" OAuth client, bundle id `com.pandam.app`. Used as
# `iosClientId` for the native SDK — iOS only, required for Google sign-in
# to work in a Development/Production build on a real iPhone.
# Its reversed form (com.googleusercontent.apps.<the id>) must also be set
# as `iosUrlScheme` in apps/app/app.json's
# `@react-native-google-signin/google-signin` plugin entry.
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=

# -----------------------------------------------------------------------------
# Cloudflare Worker (apps/worker)
# Server-side secrets are provided at runtime via `wrangler secret put` in
# deployed environments, and via apps/worker/.dev.vars locally (gitignored).
# The names below document what will eventually be required.
# -----------------------------------------------------------------------------
# Cloudflare account (used by wrangler / EAS / CI, not by the Worker runtime)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Worker runtime vars/secrets (set locally in apps/worker/.dev.vars).
# Authentication needs NO secret: password + session-token hashing use the
# runtime's Web Crypto (PBKDF2 / SHA-256). See docs/architecture/auth.md.
# CORS_ORIGINS  — comma-separated extra browser origins allowed to send
#                 credentialed requests (localhost dev origins are built in).
# SENTRY_DSN, POSTHOG_KEY, POSTHOG_HOST — observability, optional.
# CORS_ORIGINS=https://app.pandam.example

# -----------------------------------------------------------------------------
# EAS Build (mobile)
# -----------------------------------------------------------------------------
EAS_PROJECT_ID=
